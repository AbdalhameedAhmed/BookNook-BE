# Backend storage: memory for demo/tests, supabase for persistent listings.
RFOOF_STORAGE=memory

# Server-side Supabase credentials. Use the sb_secret_ key; never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# --- Authentication (owned by this API) ---
# Signs access tokens. Required outside memory mode. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
AUTH_JWT_SECRET=
# Access token lifetime in minutes (default 7 days).
AUTH_ACCESS_TOKEN_TTL_MINUTES=10080
# Public frontend origin used to build links in confirmation / reset emails.
FRONTEND_URL=http://localhost:5173

# --- Email ---
# smtp (default outside memory mode) or console (prints emails to stdout; local development only).
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465), or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rfoof <no-reply@example.com>
