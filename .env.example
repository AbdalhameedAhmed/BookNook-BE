# Backend storage: memory for demo/tests, supabase for persistent listings.
RFOOF_STORAGE=memory

# Server-side Supabase credentials. Use the sb_secret_ key; never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# --- Authentication (owned by this API) ---
# Signs access tokens. Required outside memory mode. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
AUTH_JWT_SECRET=
# Access token lifetime in minutes (default 7 days).
AUTH_ACCESS_TOKEN_TTL_MINUTES=10080
# Public frontend origin used to build links in confirmation / reset emails.
FRONTEND_URL=http://localhost:5173

# --- Email ---
# smtp (default outside memory mode) or console (prints emails to stdout; local development only).
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465), or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rfoof <no-reply@example.com>

# --- Wallet ---
# E-wallet number users transfer top-ups to (shown on the wallet page). Defaults to 01109261212.
WALLET_EWALLET_NUMBER=01109261212
# Flat platform fee in EGP charged to each party of a sale or exchange. Defaults to 10.
PLATFORM_FEE_EGP=10

# --- Web Push notifications (optional) ---
# Leave empty to keep notifications in-app only. Generate with: uv run python scripts/generate_vapid_keys.py
# The public key is served to the frontend by GET /api/v1/push/public-key. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services if they need to reach the operator (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@example.com
